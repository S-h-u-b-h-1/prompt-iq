{
  "manifest_version": 3,
  "name": "PromptIQ by Shubhaang",
  "short_name": "PromptIQ",
  "version": "1.0.17",
  "description": "Free prompt scoring and rewriting by Shubhaang Kataruka for ChatGPT, Claude, Gemini, and more.",
  "homepage_url": "https://promptiq-theta.vercel.app/",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://promptiq-theta.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://poe.com/*",
        "https://you.com/*"
      ],
      "js": ["src/content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "store_icon.png"
  },
  "action": {
    "default_popup": "src/popup/onboarding.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "store_icon.png"
    }
  }
}
